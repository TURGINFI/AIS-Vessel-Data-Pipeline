ENVIRONMENT=development
LOG_LEVEL=INFO

AIS_PROVIDER=replay
AIS_API_URL=
AIS_API_KEY=
AIS_POLL_INTERVAL=15
AIS_REQUEST_TIMEOUT_SECONDS=10
AIS_MAX_BACKOFF_SECONDS=60
AIS_STREAM_URL=wss://stream.aisstream.io/v0/stream
# One or more boxes as min_lat,min_lon,max_lat,max_lon; separate boxes with semicolons.
# The value below requests the whole world when the selected provider allows it.
AIS_BOUNDING_BOXES=-90,-180,90,180
AIS_FILTER_MESSAGE_TYPES=PositionReport,ShipStaticData,StandardClassBPositionReport,ExtendedClassBPositionReport

REPLAY_DATA_PATH=data/sample/replay_ais.csv
REPLAY_SPEED_MULTIPLIER=30
REPLAY_LOOP=true

DATABASE_URL=sqlite:///./storage/ais.db
HISTORY_WINDOW_MINUTES=60
MAX_POSITIONS_PER_VESSEL=500

PREDICTION_HORIZON_SECONDS=300
PREDICTION_STEP_SECONDS=30
MAX_PREDICTION_SPEED_KNOTS=50

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_API_URL=http://localhost:8000
FRONTEND_WS_URL=ws://localhost:8000
